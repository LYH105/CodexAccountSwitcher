<Window x:Class="CodexAccountSwitcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Codex 账号管理"
        Width="980"
        Height="760"
        MinWidth="860"
        MinHeight="620"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{StaticResource BackgroundBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="42"
                            ResizeBorderThickness="6"
                            CornerRadius="18"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="42" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#F7FFFFFF" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
                    <Border Width="24" Height="24" CornerRadius="7" Background="{StaticResource AccentBrush}" Margin="0,0,10,0">
                        <Viewbox Width="14" Height="14">
                            <Path Fill="White"
                                  Data="M12,2 A4,4 0 1 1 12,10 A4,4 0 1 1 12,2 M5,21 C5,16.8 8.1,14 12,14 C15.9,14 19,16.8 19,21 Z" />
                        </Viewbox>
                    </Border>
                    <TextBlock Text="Codex 账号管理" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource WindowButtonStyle}" Click="MinimizeButton_Click" AutomationProperties.Name="最小化">
                        <Path Data="M4,11 L20,11" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" />
                    </Button>
                    <Button Style="{StaticResource WindowButtonStyle}" Click="MaximizeButton_Click" AutomationProperties.Name="最大化">
                        <Rectangle Width="12" Height="12" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.3" />
                    </Button>
                    <Button Style="{StaticResource WindowButtonStyle}" Click="CloseButton_Click" AutomationProperties.Name="关闭">
                        <Path Data="M5,5 L19,19 M19,5 L5,19" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#F7F7FA" Offset="0" />
                    <GradientStop Color="#EDF6FF" Offset="0.56" />
                    <GradientStop Color="#F4F1FF" Offset="1" />
                </LinearGradientBrush>
            </Grid.Background>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="30,26,30,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="全部账号" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="30" FontWeight="Bold" />
                    <TextBlock Text="查看实时额度，并安全管理与切换账号"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="14"
                               Margin="0,6,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource PrimaryButtonStyle}"
                            IsEnabled="{Binding CanLogin}"
                            Click="LoginButton_Click"
                            Margin="0,0,10,0"
                            AutomationProperties.Name="登录新账号">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="16" Height="16" Margin="0,0,8,0">
                                <Path Data="M12,3 A4,4 0 1 1 12,11 A4,4 0 1 1 12,3 M5,21 C5,16.8 8.1,14 12,14 C13.7,14 15.2,14.5 16.4,15.4 M19,13 L19,21 M15,17 L23,17"
                                      Stroke="White"
                                      StrokeThickness="1.8"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round" />
                            </Viewbox>
                            <TextBlock Text="{Binding LoginButtonText}" Foreground="White" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource SecondaryButtonStyle}"
                            IsEnabled="{Binding CanRefresh}"
                            Click="RefreshButton_Click"
                            AutomationProperties.Name="刷新全部账号额度">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="15" Height="15" Margin="0,0,8,0">
                                <Path Data="M20,11 A8,8 0 1 1 17.7,5.3 M20,4 L20,11 L13,11"
                                      Stroke="{StaticResource TextPrimaryBrush}"
                                      StrokeThickness="1.8"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round" />
                            </Viewbox>
                            <TextBlock Text="刷新额度" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <Border Grid.Row="1"
                    Margin="30,0,30,18"
                    Padding="16,13"
                    Background="#EFFFFFFF"
                    BorderBrush="#80B9FF"
                    BorderThickness="1"
                    CornerRadius="16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Ellipse Width="8" Height="8" Fill="#34C759" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="当前账号" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,9,0" />
                        <TextBlock Text="{Binding CurrentAccountText}" FontWeight="SemiBold" />
                    </StackPanel>
                    <TextBlock Grid.Column="2"
                               Text="{Binding LastRefreshText}"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="12"
                               VerticalAlignment="Center" />
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="2"
                          Margin="30,0,20,0"
                          Padding="0,0,10,0"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding Accounts}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,12" Padding="18" CornerRadius="18" BorderThickness="1">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
                                        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Summary.IsCurrent}" Value="True">
                                                <Setter Property="Background" Value="#F2F8FF" />
                                                <Setter Property="BorderBrush" Value="#62A8FF" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="280" />
                                        <ColumnDefinition Width="*" MinWidth="220" />
                                        <ColumnDefinition Width="148" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Grid Grid.Column="0" Grid.RowSpan="2" Margin="0,0,18,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="48" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="46" Height="46" CornerRadius="15" Background="{StaticResource AvatarBrush}" VerticalAlignment="Top">
                                            <Viewbox Width="24" Height="24">
                                                <Path Fill="White"
                                                      Data="M12,3 A4,4 0 1 1 12,11 A4,4 0 1 1 12,3 M4.5,21 C4.5,16.7 7.7,14 12,14 C16.3,14 19.5,16.7 19.5,21 Z" />
                                            </Viewbox>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="13,0,0,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding DisplayName}"
                                                           FontSize="16"
                                                           FontWeight="SemiBold"
                                                           MaxWidth="125"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding DisplayNameToolTip}" />
                                                <Border Background="#34C759"
                                                        CornerRadius="5"
                                                        Padding="7,2"
                                                        Margin="8,0,0,0"
                                                        VerticalAlignment="Center"
                                                        Visibility="{Binding Summary.IsCurrent, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <TextBlock Text="当前" Foreground="White" FontSize="10" FontWeight="Bold" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Summary.Email}"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       FontSize="12"
                                                       Margin="0,5,0,0"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding Summary.Email}" />
                                             <StackPanel Orientation="Horizontal" Margin="0,9,0,0">
                                                 <Border Background="#EAF2FF" CornerRadius="6" Padding="7,3">
                                                     <TextBlock Text="{Binding PlanText}" Foreground="#005BC4" FontSize="11" FontWeight="SemiBold" />
                                                 </Border>
                                             </StackPanel>
                                        </StackPanel>
                                    </Grid>

                                    <StackPanel Grid.Column="1" Margin="0,1,30,0"
                                                Visibility="{Binding IsQuotaVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBlock Text="{Binding PrimaryTitle}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" />
                                        <TextBlock Text="{Binding PrimaryRemainingText}" FontSize="15" FontWeight="SemiBold" Margin="0,4,0,7" />
                                        <ProgressBar Value="{Binding PrimaryRemainingPercent, Mode=OneWay}" Maximum="100" />
                                        <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                                            <TextBlock Text="{Binding PrimaryResetText}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" />
                                            <TextBlock Text="  ·  " Foreground="{StaticResource TextSecondaryBrush}"
                                                       Visibility="{Binding HasCredits, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                            <TextBlock Text="{Binding CreditsText}" Foreground="{StaticResource AccentBrush}" FontSize="11"
                                                       Visibility="{Binding HasCredits, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        </StackPanel>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,30,0"
                                                Visibility="{Binding HasQuotaError, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBlock Text="额度状态" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" />
                                        <TextBlock Text="{Binding QuotaStateText}" Foreground="{StaticResource WarningBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,5,0,0" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,30,0"
                                                Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBlock Text="正在查询额度…" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                                        <ProgressBar IsIndeterminate="True" Margin="0,10,0,0" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Grid.RowSpan="2" VerticalAlignment="Center">
                                        <Button Style="{StaticResource SecondaryButtonStyle}"
                                                IsEnabled="{Binding CanAnalyze}"
                                                Content="精确分析"
                                                Click="AnalyzeButton_Click"
                                                Margin="0,0,0,8"
                                                HorizontalAlignment="Stretch"
                                                AutomationProperties.Name="精确分析此账号 Token 与成本" />
                                        <Button Style="{StaticResource SecondaryButtonStyle}"
                                                IsEnabled="{Binding CanSwitch}"
                                                Content="{Binding SwitchButtonText}"
                                                Click="SwitchButton_Click"
                                                Margin="0,0,0,8"
                                                HorizontalAlignment="Stretch"
                                                AutomationProperties.Name="切换到此账号" />
                                        <Button Style="{StaticResource DangerButtonStyle}"
                                                IsEnabled="{Binding CanDelete}"
                                                Content="{Binding DeleteButtonText}"
                                                Click="DeleteButton_Click"
                                                HorizontalAlignment="Stretch"
                                                Visibility="{Binding IsDeleteVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                AutomationProperties.Name="删除此账号" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <Border Grid.Row="3" Background="#EFFFFFFF" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="30,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                    <TextBlock Grid.Column="1" Text="无后台轮询 · 令牌不写入日志" Foreground="#73737C" FontSize="11" />
                </Grid>
            </Border>
        </Grid>

        <Grid x:Name="ConfirmOverlay" Grid.RowSpan="2" Panel.ZIndex="20" Visibility="Collapsed">
            <Border Background="#66000000" />
            <Border Width="460"
                    Padding="26"
                    Background="{StaticResource SurfaceRaisedBrush}"
                    BorderBrush="#D6D6DC"
                    BorderThickness="1"
                    CornerRadius="22"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel>
                    <Border x:Name="ConfirmIconBorder" Width="42" Height="42" CornerRadius="13" Background="#FFF2D6" HorizontalAlignment="Left">
                        <Viewbox Width="21" Height="21">
                            <Path x:Name="ConfirmIconPath" Data="M12,3 L22,21 L2,21 Z M12,9 L12,15 M12,18 L12,18.1"
                                  Stroke="{StaticResource WarningBrush}"
                                  StrokeThickness="1.8"
                                  StrokeLineJoin="Round" />
                        </Viewbox>
                    </Border>
                    <TextBlock x:Name="ConfirmTitleText" Text="确认切换账号" FontSize="21" FontWeight="SemiBold" Margin="0,18,0,0" />
                    <TextBlock x:Name="ConfirmAccountText" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" Margin="0,8,0,0" />
                    <TextBlock x:Name="ConfirmBodyText" Text="工具会交换目标账号与当前账号，旧的当前凭据会完整保存；随后完整关闭并重新启动 Store 版 ChatGPT。ChatGPT 内正在运行的 Codex 任务会被中断，VS Code 窗口及其扩展进程不会被关闭。"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               TextWrapping="Wrap"
                               LineHeight="21"
                               Margin="0,14,0,0" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
                        <Button Style="{StaticResource SecondaryButtonStyle}" Content="取消" Click="CancelSwitchButton_Click" Margin="0,0,10,0" />
                        <Button x:Name="ConfirmActionButton" Style="{StaticResource PrimaryButtonStyle}" Content="切换并重启" Click="ConfirmActionButton_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <Grid x:Name="LoginOverlay" Grid.RowSpan="2" Panel.ZIndex="21" Visibility="Collapsed">
            <Border Background="#66000000" />
            <Border Width="480"
                    Padding="28"
                    Background="{StaticResource SurfaceRaisedBrush}"
                    BorderBrush="#B9D9FF"
                    BorderThickness="1"
                    CornerRadius="22"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel>
                    <Border Width="46" Height="46" CornerRadius="14" Background="#E7F3FF" HorizontalAlignment="Left">
                        <Viewbox Width="24" Height="24">
                            <Path Data="M12,3 A4,4 0 1 1 12,11 A4,4 0 1 1 12,3 M5,21 C5,16.8 8.1,14 12,14 C13.7,14 15.2,14.5 16.4,15.4 M19,13 L19,21 M15,17 L23,17"
                                  Stroke="{StaticResource AccentBrush}"
                                  StrokeThickness="1.8"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round" />
                        </Viewbox>
                    </Border>
                    <TextBlock Text="在浏览器中登录新账号" FontSize="21" FontWeight="SemiBold" Margin="0,18,0,0" />
                    <TextBlock x:Name="LoginProgressText"
                               Text="官方 Codex 登录页将自动打开，完成登录后此窗口会继续处理。"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               TextWrapping="Wrap"
                               LineHeight="21"
                               Margin="0,10,0,0" />
                    <Border Background="#EEF7FF" BorderBrush="#B8D8FF" BorderThickness="1" CornerRadius="12" Padding="13,11" Margin="0,18,0,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="{StaticResource AccentBrush}" Margin="0,0,10,0" VerticalAlignment="Center" />
                            <TextBlock Text="当前登录凭据在登录完成前不会被修改" FontSize="12" />
                        </StackPanel>
                    </Border>
                    <Button x:Name="CancelLoginButton"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Content="取消登录"
                            Click="CancelLoginButton_Click"
                            HorizontalAlignment="Right"
                            Margin="0,22,0,0"
                            AutomationProperties.Name="取消新账号登录" />
                </StackPanel>
            </Border>
        </Grid>

        <Grid x:Name="AnalyticsOverlay" Grid.RowSpan="2" Panel.ZIndex="22" Visibility="Collapsed">
            <Border Background="#66000000" />
            <Border Width="840"
                    Height="650"
                    Padding="26"
                    Background="{StaticResource SurfaceRaisedBrush}"
                    BorderBrush="#B9D9FF"
                    BorderThickness="1"
                    CornerRadius="22"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="46" Height="46" CornerRadius="14" Background="#E7F3FF">
                            <Viewbox Width="24" Height="24">
                                <Path Data="M4,19 L9,13 L13,16 L20,7 M15,7 L20,7 L20,12"
                                      Stroke="{StaticResource AccentBrush}"
                                      StrokeThickness="1.9"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round" />
                            </Viewbox>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="精确 Token / 成本分析" FontSize="22" FontWeight="SemiBold" />
                            <TextBlock x:Name="AnalyticsAccountText"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="12"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                        <Button Grid.Column="2"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Content="关闭"
                                Click="CloseAnalyticsButton_Click"
                                AutomationProperties.Name="关闭精确分析" />
                    </Grid>

                    <Border Grid.Row="1"
                            Background="#F2F7FF"
                            BorderBrush="#D2E5FF"
                            BorderThickness="1"
                            CornerRadius="14"
                            Padding="14"
                            Margin="0,18,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="开始日期" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" />
                                <DatePicker x:Name="AnalyticsStartDatePicker"
                                            Width="130"
                                            Margin="0,5,0,0"
                                            FontSize="12"
                                            SelectedDateFormat="Short" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                <TextBlock Text="结束日期" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" />
                                <DatePicker x:Name="AnalyticsEndDatePicker"
                                            Width="130"
                                            Margin="0,5,0,0"
                                            FontSize="12"
                                            SelectedDateFormat="Short" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="14,17,0,0">
                                <Button Style="{StaticResource SecondaryButtonStyle}" Content="近 7 天" Click="AnalyticsSevenDaysButton_Click" Padding="12,8" />
                                <Button Style="{StaticResource SecondaryButtonStyle}" Content="近 30 天" Click="AnalyticsThirtyDaysButton_Click" Padding="12,8" Margin="8,0,0,0" />
                            </StackPanel>
                            <Button x:Name="RunAnalyticsButton"
                                    Grid.Column="6"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Content="精确查询"
                                    Click="RunAnalyticsButton_Click"
                                    Margin="14,17,0,0"
                                    Padding="18,8"
                                    AutomationProperties.Name="执行精确 Token 成本查询" />
                        </Grid>
                    </Border>

                    <Grid Grid.Row="2">
                        <StackPanel x:Name="AnalyticsLoadingPanel" VerticalAlignment="Center" Visibility="Collapsed">
                            <TextBlock Text="正在读取两个 Analytics 接口并逐模型核算…"
                                       HorizontalAlignment="Center"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="13" />
                            <ProgressBar IsIndeterminate="True" Width="300" Margin="0,14,0,0" />
                        </StackPanel>

                        <Border x:Name="AnalyticsErrorPanel"
                                Background="#FFF1F2"
                                BorderBrush="#FFD0D5"
                                BorderThickness="1"
                                CornerRadius="14"
                                Padding="18"
                                VerticalAlignment="Top"
                                Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="无法完成精确分析" FontWeight="SemiBold" Foreground="{StaticResource DangerBrush}" />
                                <TextBlock x:Name="AnalyticsErrorText"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>

                        <ScrollViewer x:Name="AnalyticsResultPanel"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      Visibility="Collapsed">
                            <StackPanel Margin="0,0,8,0">
                                <UniformGrid Columns="4">
                                    <Border Background="#F7F7FA" CornerRadius="14" Padding="14" Margin="0,0,8,0">
                                        <StackPanel>
                                            <TextBlock Text="真实总 Token" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" />
                                            <TextBlock x:Name="AnalyticsTotalTokensText" FontSize="20" FontWeight="SemiBold" Margin="0,6,0,0" />
                                        </StackPanel>
                                    </Border>
                                    <Border Background="#F7F7FA" CornerRadius="14" Padding="14" Margin="0,0,8,0">
                                        <StackPanel>
                                            <TextBlock Text="缓存命中率" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" />
                                            <TextBlock x:Name="AnalyticsCacheRateText" FontSize="20" FontWeight="SemiBold" Margin="0,6,0,0" />
                                        </StackPanel>
                                    </Border>
                                    <Border Background="#F2F8FF" CornerRadius="14" Padding="14" Margin="0,0,8,0">
                                        <StackPanel>
                                            <TextBlock Text="Codex 等价 Credits" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" />
                                            <TextBlock x:Name="AnalyticsCreditsText" Foreground="{StaticResource AccentBrush}" FontSize="20" FontWeight="SemiBold" Margin="0,6,0,0" />
                                        </StackPanel>
                                    </Border>
                                    <Border Background="#F2F8FF" CornerRadius="14" Padding="14">
                                        <StackPanel>
                                            <TextBlock Text="API Standard 等价" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" />
                                            <TextBlock x:Name="AnalyticsApiCostText" Foreground="{StaticResource AccentBrush}" FontSize="20" FontWeight="SemiBold" Margin="0,6,0,0" />
                                        </StackPanel>
                                    </Border>
                                </UniformGrid>

                                <Border Background="#F7F7FA" CornerRadius="14" Padding="14" Margin="0,12,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="未缓存输入" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" />
                                            <TextBlock x:Name="AnalyticsUncachedText" FontWeight="SemiBold" Margin="0,4,0,0" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="缓存输入" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" />
                                            <TextBlock x:Name="AnalyticsCachedText" FontWeight="SemiBold" Margin="0,4,0,0" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="输出" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" />
                                            <TextBlock x:Name="AnalyticsOutputText" FontWeight="SemiBold" Margin="0,4,0,0" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="3">
                                            <TextBlock Text="Turns / 有效日" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" />
                                            <TextBlock x:Name="AnalyticsTurnsText" FontWeight="SemiBold" Margin="0,4,0,0" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="4">
                                            <TextBlock Text="精确覆盖率" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" />
                                            <TextBlock x:Name="AnalyticsCoverageText" FontWeight="SemiBold" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <TextBlock Text="模型与速度明细" FontSize="15" FontWeight="SemiBold" Margin="0,18,0,8" />
                                <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="12">
                                    <StackPanel>
                                        <Grid Margin="4,0,4,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="210" />
                                                <ColumnDefinition Width="80" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="125" />
                                                <ColumnDefinition Width="105" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="模型" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" />
                                            <TextBlock Grid.Column="1" Text="速度" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" />
                                            <TextBlock Grid.Column="2" Text="Token" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" />
                                            <TextBlock Grid.Column="3" Text="等价 Credits" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" />
                                            <TextBlock Grid.Column="4" Text="API 成本" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" />
                                        </Grid>
                                        <ItemsControl x:Name="AnalyticsModelsList">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="4,7">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="210" />
                                                            <ColumnDefinition Width="80" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="125" />
                                                            <ColumnDefinition Width="105" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Label}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="{Binding AccuracyText}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" Margin="0,2,0,0" />
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="1" Text="{Binding SpeedText}" VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="2" Text="{Binding TokenText}" VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="3" Text="{Binding CreditsText}" VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="4" Text="{Binding ApiCostText}" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>

                                <Border x:Name="AnalyticsWarningPanel"
                                        Background="#FFF8E8"
                                        BorderBrush="#FFE0A3"
                                        BorderThickness="1"
                                        CornerRadius="12"
                                        Padding="12"
                                        Margin="0,12,0,0"
                                        Visibility="Collapsed">
                                    <TextBlock x:Name="AnalyticsWarningText"
                                               Foreground="{StaticResource WarningBrush}"
                                               TextWrapping="Wrap"
                                               FontSize="11" />
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <Grid Grid.Row="3" Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="AnalyticsSourceText"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="10" />
                        <TextBlock Grid.Column="1"
                                   Text="费用为公开 API 等价估算，不是订阅账单"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="10" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
